{
  "realm": "orderflow",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": { "realm": [ { "name": "admin", "description": "Shop administrator: ships and refunds orders, edits the catalog" } ] },
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "orderflow-web",
      "name": "Orderflow web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [ "http://localhost:5173/*" ],
      "webOrigins": [ "http://localhost:5173" ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@orderflow.local",
      "firstName": "Shop",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [ "admin" ],
      "credentials": [ { "type": "password", "value": "admin", "temporary": false } ]
    },
    {
      "username": "demo",
      "email": "demo@orderflow.local",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "demo", "temporary": false } ]
    },
    {
      "username": "alice",
      "email": "alice@orderflow.local",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [ { "type": "password", "value": "alice", "temporary": false } ]
    }
  ]
}
