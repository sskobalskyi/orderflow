{
  "uid": "orderflow-saga",
  "title": "Orderflow saga flow",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["orderflow"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Orders submitted (5m)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(orderflow_orders_submitted_total[5m]))" }]
    },
    {
      "id": 2, "type": "stat", "title": "Rejected share (5m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.2 }, { "color": "red", "value": 0.5 }] } } },
      "targets": [{ "refId": "A", "expr": "sum(increase(orderflow_orders_completed_total{outcome=\"rejected\"}[5m])) / sum(increase(orderflow_orders_completed_total[5m]))" }]
    },
    {
      "id": 3, "type": "stat", "title": "Order duration p95 (5m)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(orderflow_orders_duration_seconds_bucket[5m])))" }]
    },
    {
      "id": 4, "type": "stat", "title": "Consumer errors (5m)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "targets": [{ "refId": "A", "expr": "sum(increase(messaging_masstransit_consume_errors_ea_total[5m])) or vector(0)" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Saga outcomes per minute",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "submitted", "expr": "sum(rate(orderflow_orders_submitted_total[2m])) * 60" },
        { "refId": "B", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (rate(orderflow_orders_completed_total[2m])) * 60" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Payments and stock reservations per minute",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "payment {{result}}", "expr": "sum by (result) (rate(orderflow_payments_processed_total[2m])) * 60" },
        { "refId": "B", "legendFormat": "stock {{result}}", "expr": "sum by (result) (rate(orderflow_stock_reservations_total[2m])) * 60" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Order duration (submit to final outcome)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.5, sum by (le) (rate(orderflow_orders_duration_seconds_bucket[2m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(orderflow_orders_duration_seconds_bucket[2m])))" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Message consume duration p95 by service",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [{ "refId": "A", "legendFormat": "{{job}}", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(messaging_masstransit_consume_duration_milliseconds_bucket[2m])))" }]
    },
    {
      "id": 9, "type": "table", "title": "Recent order traces",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "refId": "A", "queryType": "traceql", "tableType": "traces", "query": "{ resource.service.name = \"gateway\" && name = \"POST /api/orders\" }", "limit": 20 }]
    }
  ]
}
