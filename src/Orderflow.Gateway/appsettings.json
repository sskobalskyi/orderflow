{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Auth": {
    "MetadataAddress": "http://localhost:8180/realms/orderflow/.well-known/openid-configuration",
    "Issuer": "http://localhost:8180/realms/orderflow"
  },
  "Cors": { "Origins": [ "http://localhost:5173" ] },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "orders-root": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/orders" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "admin-orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/admin/orders/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "admin-orders-root": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/admin/orders" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "admin-products": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "admin",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/admin/products/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "products": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/products/{**rest}" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "products-root": {
        "ClusterId": "catalog",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/products" },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },
    "Clusters": {
      "orders": { "Destinations": { "d1": { "Address": "http://localhost:8081" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://localhost:8084" } } }
    }
  }
}
